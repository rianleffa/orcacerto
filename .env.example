# ==============================================================================
# ORÇACERTO — VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto e configure suas credenciais.
# NUNCA insira segredos reais (Client Secret ou Service Role Key) no frontend!

# ------------------------------------------------------------------------------
# 1. SUPABASE (Conexão do Frontend com Supabase)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Temporarily expose all existing features without plan limits or checkout.
# Set to false only when payments are ready and the database setting is disabled.
VITE_FREE_ACCESS_ENABLED=true

# ------------------------------------------------------------------------------
# 2. URL DA APLICAÇÃO (Opcional - caso queira fixar a URL base de redirecionamento)
# ------------------------------------------------------------------------------
# Se omitido, o sistema utilizará dinamicamente window.location.origin.
# URLs localhost só são usadas quando o app também está aberto em localhost.
# Local: http://localhost:5173
# Produção: https://seu-dominio.com.br
# VITE_SITE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (CLIENT ID & SEGREDOS)
# ------------------------------------------------------------------------------
# O Client ID do Google pode ser referenciado no frontend:
# VITE_GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
#
# IMPORTANTE: O Google Client Secret NUNCA deve ser inserido neste arquivo!
# Por segurança de aplicações SPA (Single Page Application), o Client Secret
# NUNCA pode ser exposto ao navegador do usuário.
#
# Onde configurar as credenciais do Google OAuth:
# -> Acesse: Supabase Dashboard > Authentication > Providers > Google
#    - Client ID: seu_client_id.apps.googleusercontent.com (criado no Google Cloud)
#    - Client Secret: seu_client_secret (criado no Google Cloud)
#
# No Google Cloud Console (APIs e Serviços > Credenciais > ID do cliente OAuth 2.0):
# -> Origens JavaScript autorizadas:
#    - http://localhost:5173
#    - https://seu-projeto.supabase.co
#    - https://seu-dominio.com.br (quando em produção)
# -> URIs de redirecionamento autorizados:
#    - https://<seu-projeto-ref>.supabase.co/auth/v1/callback
#
# No painel do Supabase (Authentication > URL Configuration):
# -> Site URL: http://localhost:5173 (ou https://seu-dominio.com.br em produção)
# -> Redirect URLs:
#    - http://localhost:5173/**
#    - https://seu-dominio.com.br/**

# ------------------------------------------------------------------------------
# 4. GATEWAY DE PAGAMENTOS (Estrutura pronta para produção)
# ------------------------------------------------------------------------------
# VITE_STRIPE_PUBLIC_KEY=pk_test_...
# VITE_MERCADO_PAGO_PUBLIC_KEY=APP_USR-...
