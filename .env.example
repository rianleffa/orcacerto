# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# A publishable key (ou a chave anon legada) é pública e deve estar protegida por RLS.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_publica

# Omitido ou true mantém o modo de acesso gratuito já configurado no app.
VITE_FREE_ACCESS_ENABLED=true

# Compatibilidade com projetos Supabase que ainda usam a chave anon legada:
# VITE_SUPABASE_ANON_KEY=sua_chave_anon_publica

# O provedor Google é configurado no Supabase Auth; não adicione o Client Secret aqui.
