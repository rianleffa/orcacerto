# ==============================================================================
# ORÇACERTO — VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================

# SUPABASE (Opcional para teste local imediato — o app conta com fallback offline e dados demo automáticos)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# INTELIGÊNCIA ARTIFICIAL (Opcional — o app possui gerador heurístico offline integrado para melhorar descrições)
# VITE_OPENAI_API_KEY=sk-...
# VITE_GEMINI_API_KEY=AIzaSy...

# GATEWAY DE PAGAMENTOS (Estrutura pronta para produção)
# VITE_STRIPE_PUBLIC_KEY=pk_test_...
# VITE_MERCADO_PAGO_PUBLIC_KEY=APP_USR-...
